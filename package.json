{
  "name": "meow-civilization",
  "version": "0.29.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "pretest": "node scripts/generate-legacy-data.cjs",
    "predev": "node scripts/generate-legacy-data.cjs",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "node tests/run-browser.cjs",
    "benchmark:ui": "tsx scripts/benchmark-ui-preview.ts --cached",
    "check": "npm run typecheck && node scripts/run-tests.mjs && npm run test:browser && npm run build",
    "check:fast": "npm run typecheck && node scripts/run-tests.mjs",
    "fixtures:make": "node scripts/make-fixture.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "vue": "^3.5.43"
  }
}
